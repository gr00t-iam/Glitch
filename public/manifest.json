{
  "name": "Glitch",
  "short_name": "Glitch",
  "description": "A local-first browser PWA harness for self-correcting multi-agent automation.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "lang": "en",
  "dir": "ltr",
  "background_color": "#0c1118",
  "theme_color": "#0c1118",
  "orientation": "any",
  "categories": ["productivity", "developer", "utilities"],
  "shortcuts": [
    {
      "name": "New chat",
      "short_name": "New chat",
      "description": "Start a fresh conversation thread",
      "url": "/?action=new-chat",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Prompt library",
      "short_name": "Prompts",
      "description": "Open your saved prompts",
      "url": "/?action=prompts",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
